{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: Run game",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=amoeba-rl",
                    "--package=amoeba-rl"
                ],
                "filter": {
                    "name": "amoeba-rl",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Rust: Unit Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--lib",
                    "--package=amoeba-rl"
                ],
                "filter": {
                    "name": "amoeba_rl",
                    "kind": "lib"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
